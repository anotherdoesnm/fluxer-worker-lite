FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
RUN GOFLAGS=-mod=mod go mod tidy \
 && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/observer ./cmd/observer

FROM alpine:3.20
RUN adduser -D -H -u 10001 w
COPY --from=build /out/observer /observer
USER 10001
ENTRYPOINT ["/observer"]
